{
  "name": "hover-decode",
  "displayName": "Hover Decode",
  "description": "Hover over Windows error codes, epoch timestamps, dates, sizes, durations, hex, base64, HTTP status codes, or your own and your team's dictionary terms to see what they mean.",
  "icon": "icon.png",
  "version": "0.2.0",
  "publisher": "Ruminem",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ruminem/hover-decode.git"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "hover",
    "epoch",
    "timestamp",
    "hex",
    "base64",
    "http status",
    "hresult",
    "windows error",
    "terminal"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "hoverDecode.openDictionary",
        "title": "%command.openDictionary%"
      },
      {
        "command": "hoverDecode.openTeamDictionary",
        "title": "%command.openTeamDictionary%"
      },
      {
        "command": "hoverDecode.resetDictionary",
        "title": "%command.resetDictionary%"
      }
    ]
  },
  "scripts": {
    "test": "node test.js",
    "package": "npx --yes @vscode/vsce@3 package",
    "icon": "node tools/make-icon.js"
  }
}
